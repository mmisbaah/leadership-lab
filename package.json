{
  "name": "leadership-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:inline": "node scripts/dev/build-inline.mjs && wrangler deploy --config .wrangler/inline/wrangler.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node tests/run.mjs",
    "test:content": "node --test tests/content.test.mjs",
    "export-content": "node scripts/export-content.mjs",
    "restore-backup": "node scripts/restore-backup.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "generate-backup-key": "node scripts/generate-backup-key.mjs",
    "apply-photos": "node scripts/apply-photos.mjs",
    "migrate-kv-to-d1": "node scripts/migrate-kv-to-d1.js",
    "i18n-check": "node scripts/i18n-check.mjs",
    "db:migrate": "wrangler d1 migrations apply leadership-lab --remote",
    "db:migrate:local": "wrangler d1 migrations apply leadership-lab --local"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "playwright": "1.63.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
